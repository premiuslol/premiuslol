+import { describe, expect, it } from 'vitest';
+import { normalizeGitHubPullRequestUrl as normalize } from './github-pr';
+
+describe('Escaro #66 — PR link validation before bounty release', () => {
+  it.each([
+    [null, null],
+    [undefined, null],
+    ['', null],
+    [' \t\n ', null],
+    ['https://github.com/team/repo/pull/42', 'https://github.com/team/repo/pull/42'],
+    ['  https://github.com/team/repo/pull/42/ ', 'https://github.com/team/repo/pull/42'],
+    ['https://github.com/team/repo/pull/42#discussion_r12', 'https://github.com/team/repo/pull/42'],
+    ['https://github.com/team/repo/pull/42?foo=bar', 'https://github.com/team/repo/pull/42'],
+    ['https://github.com/team/repo/pull/00001', null],
+    ['http://github.com/team/repo/pull/42', null],
+    ['https://github.com.evil.test/team/repo/pull/42', null],
+    ['https://github.com@evil.test/team/repo/pull/42', null],
+    ['https://user:password@github.com/team/repo/pull/42', null],
+    ['https://evil.test/github.com/team/repo/pull/42', null],
+    ['https://github.com/team/repo/issues/42', null],
+    ['https://github.com/team/repo/pull/0', null],
+    ['https://github.com/team/repo/pull/-2', null],
+    ['https://github.com/team/repo/pull/4extra', null],
+    ['https://github.com/team/repo/pull/', null],
+    ['https://github.com/team/repo/pull/42/files', null],
+    ['https://github.com/team/repo', null],
+    ['github.com/team/repo/pull/42', null],
+    ['/team/repo/pull/42', null],
+    ['javascript:alert(1)', null],
+    ['https://github.com./team/repo/pull/42', null],
+    ['https://github.com/team/repo/pull/42?x=github.com.evil', 'https://github.com/team/repo/pull/42'],
+  ] as const)('normalizes or rejects %s', (value, expected) => {
+    expect(normalize(value)).toBe(expected);
+  });
+});
diff --git a/src/lib/github-pr.ts b/src/lib/github-pr.ts
new file mode 100644
index 0000000..ac5c7de
--- /dev/null
+++ b/src/lib/github-pr.ts
@@ -0,0 +1,24 @@
+/**
+ * Normalizes only canonical GitHub pull-request links, discarding optional query
+ * and fragment components so payout receipts do not persist unrelated data.
+ * This is syntax validation, not proof that GitHub has merged the PR.
+ */
+export function normalizeGitHubPullRequestUrl(value: string | null | undefined): string | null {
+  if (typeof value !== 'string' || !value.trim()) return null;
+
+  let parsed: URL;
+  try {
+    parsed = new URL(value.trim());
+  } catch {
+    return null;
+  }
+
+  if (parsed.protocol !== 'https:' || parsed.hostname !== 'github.com'
+    || parsed.username || parsed.password || parsed.port) return null;
+
+  const match = /^\/([A-Za-z0-9][A-Za-z0-9-]*)\/([A-Za-z0-9_.-]+)\/pull\/([1-9][0-9]*)\/?$/.exec(parsed.pathname);
+  if (!match || match[2] === '.' || match[2] === '..') return null;
+
+  const [, owner, repo, number] = match;
+  return `https://github.com/${owner}/${repo}/pull/${number}`;
+}
